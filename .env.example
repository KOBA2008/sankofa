# Meta Model API key (leave empty to run in local mode)
META_API_KEY=
# OpenAI-compatible base URL of the Meta Model API
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_TEXT=muse-spark-1.3
META_MODEL_IMAGE=muse-image-1.0
META_MODEL_SEGMENT=sam-3.1
META_MODEL_TRANSCRIBE=muse-voice-transcribe-1.0

# Baseten (optional): Muse Spark open weights for text and vision when no Meta key is set
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Leave empty to pick a Meta model automatically
BASETEN_MODEL=
